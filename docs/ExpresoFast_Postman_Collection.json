{
  "info": {
    "name": "ExpresoFast Lab 6 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "envioId",
      "value": "1"
    },
    {
      "key": "vehiculoId",
      "value": "1"
    },
    {
      "key": "conductorId",
      "value": "1"
    },
    {
      "key": "empresaId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"jwt_token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login operador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operador\",\n  \"password\": \"operador123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"jwt_token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login conductor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"conductor1\",\n  \"password\": \"cond123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"jwt_token\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Envíos",
      "item": [
        {
          "name": "Listar envíos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/envios/optimizados"
          }
        },
        {
          "name": "Crear envío",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/envios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoRastreo\": \"EXP-9901\",\n  \"direccionDestino\": \"Cartago, Paraíso\",\n  \"pesoKg\": 5.5,\n  \"costo\": 2500,\n  \"vehiculoId\": \"{{vehiculoId}}\",\n  \"conductorId\": \"{{conductorId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creado\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"envioId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Marcar en tránsito",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/envios/{{envioId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"EN_TRANSITO\",\n  \"observaciones\": \"Iniciando ruta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Marcar entregado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/envios/{{envioId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"ENTREGADO\",\n  \"observaciones\": \"Entregado al destinatario\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ver bitácora",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/envios/{{envioId}}/bitacora"
          }
        },
        {
          "name": "Verificar transición inválida después de entregar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/envios/{{envioId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoEstado\": \"PENDIENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Rechaza transición\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catálogos (admin y operador)",
      "item": [
        {
          "name": "Vehículos para asignación",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/catalogos/vehiculos"
          }
        },
        {
          "name": "Conductores",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/catalogos/conductores"
          }
        },
        {
          "name": "Empresas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/catalogos/empresas"
          }
        }
      ]
    },
    {
      "name": "Flota (solo admin)",
      "item": [
        {
          "name": "Listar vehículos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/vehiculos"
          }
        },
        {
          "name": "Crear vehículo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/vehiculos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"TEST-02\",\n  \"capacidadKg\": 1000,\n  \"estado\": \"DISPONIBLE\",\n  \"empresaId\": \"{{empresaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"vehiculoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar vehículo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/vehiculos/{{vehiculoId}}"
          }
        },
        {
          "name": "Editar vehículo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/vehiculos/{{vehiculoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"TEST-02\",\n  \"capacidadKg\": 1500,\n  \"estado\": \"MANTENIMIENTO\",\n  \"empresaId\": \"{{empresaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar vehículo sin envíos",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/vehiculos/{{vehiculoId}}"
          }
        }
      ]
    }
  ]
}
